---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectStatusLabels } from "../lib/project-status";
import { statusIcons, statusLabels } from "../lib/status";

const formatDate = (date: Date) => new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
const posts = (await getCollection("blog", ({ data }) => !data.archived)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestNotes = posts.slice(0, 3);
const postCount = posts.length;
const projectCount = (await getCollection("project", ({ data }) => !data.archived)).length;
const selectedProjects = (await getCollection("project", ({ data }) => !data.archived)).sort((a, b) => Number(b.data.projectStatus === "validated") - Number(a.data.projectStatus === "validated")).slice(0, 2);
const currentlyLearning = ["STM32", "Embedded C", "Python", "LangChain", "RAG", "Proteus", "FastAPI"];
---

<BaseLayout title="首页 | 技术成长档案" description="记录嵌入式、Python 与 AI 应用方向的学习实践、问题排查和阶段性复盘。">
  <section class="max-w-3xl">
    <p class="mb-5 font-mono text-xs font-medium uppercase tracking-[0.2em] text-zinc-500"><span class="text-cyan-700 dark:text-cyan-400" aria-hidden="true">➜</span> hello, world.</p>
    <h1 class="text-3xl font-semibold leading-tight tracking-tight text-zinc-950 sm:text-5xl dark:text-zinc-50">你好，我正在学习<span class="bg-gradient-to-r from-cyan-700 to-cyan-600 bg-clip-text text-transparent dark:from-cyan-300 dark:to-cyan-400">嵌入式与 AI 应用开发</span>。<span aria-hidden="true" class="cursor-blink select-none font-mono text-cyan-600 dark:text-cyan-400">▊</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">这里记录我使用 C 和 Python 完成练习与工具项目，以及排查问题、验证想法和阶段复盘的过程。</p>
    <p class="mt-8 font-mono text-xs text-zinc-500">// {postCount} 篇学习记录 · {projectCount} 个项目 · 持续更新中</p>
  </section>

  <section class="mt-20">
    <p class="font-mono text-xs text-zinc-500"><span class="text-cyan-700 dark:text-cyan-400" aria-hidden="true">➜</span> 01 / LEARNING</p>
    <h2 class="mt-2 text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Currently learning</h2>
    <div class="mt-6 flex flex-wrap gap-2">{currentlyLearning.map((item) => <span class="rounded-full border border-zinc-300 px-3 py-1.5 font-mono text-xs text-zinc-700 transition-all hover:-translate-y-0.5 hover:border-cyan-500/60 hover:text-cyan-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-cyan-400/50 dark:hover:text-cyan-300">{item}</span>)}</div>
  </section>

  <section class="mt-20">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div><p class="font-mono text-xs text-zinc-500"><span class="text-cyan-700 dark:text-cyan-400" aria-hidden="true">➜</span> 02 / NOTES</p><h2 class="mt-2 text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Latest notes</h2></div>
      <a href="/blog" class="text-sm text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-cyan-700 dark:decoration-zinc-700 dark:hover:text-cyan-300">查看全部</a>
    </div>
    <div class="divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
      {latestNotes.map((note) => <article><a href={`/blog/${note.id}/`} class="group -mx-3 grid gap-2 rounded-lg px-3 py-5 transition-colors hover:bg-zinc-100/70 sm:grid-cols-[1fr_auto] sm:items-center dark:hover:bg-zinc-800/40"><div><div class="flex items-center gap-2"><span aria-label={statusLabels[note.data.status]} title={statusLabels[note.data.status]}>{statusIcons[note.data.status]}</span><h3 class="font-medium text-zinc-900 transition-colors group-hover:text-cyan-700 dark:text-zinc-100 dark:group-hover:text-cyan-300">{note.data.title}</h3><span aria-hidden="true" class="ml-auto hidden pl-2 font-mono text-cyan-700 opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100 sm:inline dark:text-cyan-400">→</span></div><p class="mt-2 text-sm leading-6 text-zinc-500">{note.data.description}</p></div><time datetime={note.data.pubDate.toISOString()} class="font-mono text-xs text-zinc-500">{formatDate(note.data.pubDate)}</time></a></article>)}
    </div>
  </section>

  <section class="mt-20">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div><p class="font-mono text-xs text-zinc-500"><span class="text-cyan-700 dark:text-cyan-400" aria-hidden="true">➜</span> 03 / PROJECTS</p><h2 class="mt-2 text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Selected projects</h2></div>
      <a href="/projects" class="text-sm text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-cyan-700 dark:decoration-zinc-700 dark:hover:text-cyan-300">查看全部</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">{selectedProjects.map((project) => <article class="rounded-xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-cyan-500/50 hover:shadow-lg hover:shadow-zinc-200/70 dark:border-zinc-800 dark:bg-zinc-950/30 dark:hover:border-cyan-400/40 dark:hover:shadow-black/30"><div class="mb-5 flex items-center gap-1.5 border-b border-zinc-100 pb-3 dark:border-zinc-800/60"><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="ml-2 truncate font-mono text-[0.7rem] text-zinc-400 dark:text-zinc-500">~/projects/{project.id}</span></div><div class="flex flex-wrap items-start justify-between gap-3"><h3 class="font-semibold text-zinc-950 dark:text-zinc-50"><a href={`/projects/${project.id}/`} class="transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">{project.data.title}</a></h3><span class="rounded-full bg-zinc-100 px-2.5 py-1 font-mono text-[0.7rem] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{projectStatusLabels[project.data.projectStatus]}</span></div><p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{project.data.description}</p><p class="mt-4 border-l-2 border-zinc-300 pl-3 text-xs leading-5 text-zinc-500 dark:border-zinc-700">验证边界：{project.data.validationNote}</p><ul class="mt-5 flex flex-wrap gap-2">{project.data.techStack.map((tech) => <li class="font-mono text-xs text-zinc-500">#{tech}</li>)}</ul><div class="mt-6 flex flex-wrap gap-4 text-sm"><a href={`/projects/${project.id}/`} class="underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-cyan-700 dark:decoration-zinc-700 dark:hover:text-cyan-300">查看详情 →</a>{project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">GitHub ↗</a>}{project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">Demo ↗</a>}</div></article>)}</div>
  </section>
</BaseLayout>
