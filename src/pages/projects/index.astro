---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectStatusLabels } from "../../lib/project-status";
const projects = await getCollection("project", ({ data }) => !data.archived);
---
<BaseLayout title="项目 | 技术成长档案" description="嵌入式与 Python 工具项目的实现范围、技术栈和真实验证边界。">
  <header class="max-w-2xl"><p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-500">Projects</p><h1 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl dark:text-zinc-50">项目</h1><p class="mt-5 text-lg leading-8 text-zinc-600 dark:text-zinc-400">用项目验证理解，同时明确区分主机端测试、硬件验证、正在开发和学习实验。</p></header>
  <div class="mt-14 grid gap-5 md:grid-cols-2">{projects.map((project, index) => <article class="crt-hover flex flex-col rounded-xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-cyan-500/50 hover:shadow-lg hover:shadow-zinc-200/70 dark:border-zinc-800 dark:bg-zinc-950/30 dark:hover:border-cyan-400/40 dark:hover:shadow-black/30"><div class="mb-5 flex items-center gap-1.5 border-b border-zinc-100 pb-3 dark:border-zinc-800/60"><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span><span class="ml-2 truncate font-mono text-[0.7rem] text-zinc-400 dark:text-zinc-500">~/projects/{project.id}</span></div><div class="flex flex-wrap items-center justify-between gap-3"><p class="font-mono text-xs text-zinc-500">PROJECT {String(index + 1).padStart(2, "0")}</p><span class="rounded-full bg-zinc-100 px-2.5 py-1 font-mono text-[0.7rem] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{projectStatusLabels[project.data.projectStatus]}</span></div><h2 class="mt-5 text-xl font-semibold text-zinc-950 dark:text-zinc-50"><a href={`/projects/${project.id}/`} class="transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">{project.data.title}</a></h2><p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-400">{project.data.description}</p><div class="mt-5 border-l-2 border-zinc-300 pl-4 dark:border-zinc-700"><p class="font-mono text-[0.7rem] uppercase tracking-wider text-zinc-500">Validation boundary</p><p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{project.data.validationNote}</p></div><ul class="mt-6 flex flex-wrap gap-2">{project.data.techStack.map((tech) => <li class="rounded-md bg-zinc-100 px-2 py-1 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{tech}</li>)}</ul><div class="mt-auto flex flex-wrap gap-4 pt-7 text-sm"><a href={`/projects/${project.id}/`} class="underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-cyan-700 dark:decoration-zinc-700 dark:hover:text-cyan-300">查看详情 →</a>{project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">GitHub ↗</a>}{project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">在线预览 ↗</a>}</div></article>)}</div>
</BaseLayout>
