---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectStatusLabels } from "../../lib/project-status";

interface Props { project: CollectionEntry<"project">; }

export async function getStaticPaths() {
  const projects = await getCollection("project", ({ data }) => !data.archived);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | 技术成长档案`} description={project.data.description}>
  <article class="mx-auto max-w-3xl">
    <a href="/projects" class="font-mono text-xs text-zinc-500 hover:text-zinc-950 dark:hover:text-zinc-100">← 返回项目</a>
    <header class="mt-10 border-b border-zinc-200 pb-10 dark:border-zinc-800">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-zinc-100 px-2.5 py-1 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{projectStatusLabels[project.data.projectStatus]}</span>
      </div>
      <h1 class="mt-5 text-3xl font-semibold leading-tight tracking-tight text-zinc-950 sm:text-5xl dark:text-zinc-50">{project.data.title}</h1>
      <p class="mt-5 text-lg leading-8 text-zinc-600 dark:text-zinc-400">{project.data.description}</p>
      <ul class="mt-6 flex flex-wrap gap-2">{project.data.techStack.map((tech) => <li class="rounded-full border border-zinc-300 px-3 py-1 font-mono text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">{tech}</li>)}</ul>
      <div class="mt-7 border-l-2 border-zinc-300 pl-4 dark:border-zinc-700">
        <p class="font-mono text-[0.7rem] uppercase tracking-wider text-zinc-500">Validation boundary</p>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{project.data.validationNote}</p>
      </div>
      {(project.data.githubUrl || project.data.demoUrl) && <div class="mt-7 flex flex-wrap gap-4 text-sm">
        {project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noreferrer" class="underline decoration-zinc-300 underline-offset-4 dark:decoration-zinc-700">GitHub ↗</a>}
        {project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noreferrer" class="underline decoration-zinc-300 underline-offset-4 dark:decoration-zinc-700">在线预览 ↗</a>}
      </div>}
    </header>
    <div class="prose prose-zinc mt-12 max-w-none prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-a:text-zinc-900 prose-a:decoration-zinc-300 prose-a:underline-offset-4 prose-code:font-mono prose-pre:border prose-pre:border-zinc-800 dark:prose-invert dark:prose-a:text-zinc-100 dark:prose-a:decoration-zinc-700"><Content /></div>
  </article>
</BaseLayout>
