---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
}

const {
  title = "技术成长档案",
  description = "记录嵌入式、Python 与 AI 应用方向的学习实践、问题排查和阶段性复盘。",
  canonical,
  ogType = "website",
  pubDate,
} = Astro.props;

const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navigation = [
  { label: "首页", href: "/" },
  { label: "学习记录", href: "/blog" },
  { label: "项目", href: "/projects" },
  { label: "关于我", href: "/about" },
];
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#18181b" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="技术成长档案 RSS" href="/rss.xml" />
    {canonicalUrl && <><link rel="canonical" href={canonicalUrl} /><meta property="og:url" content={canonicalUrl} /></>}
    <title>{title}</title>
    <style is:inline>html{background:#fafafa}html.dark{background:#18181b}</style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let dark = false;
        try {
          const saved = localStorage.getItem("theme");
          dark = saved === "dark" || (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        } catch {
          dark = matchMedia("(prefers-color-scheme: dark)").matches;
        }
        root.classList.toggle("dark", dark);
        root.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="bg-zinc-50 font-sans text-zinc-800 antialiased dark:bg-zinc-900 dark:text-zinc-200">
    <a href="#main-content" class="sr-only fixed left-4 top-4 z-50 rounded-md bg-zinc-950 px-4 py-2 text-sm font-medium text-white focus:not-sr-only dark:bg-zinc-50 dark:text-zinc-950">跳到主要内容</a>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-zinc-200/80 bg-zinc-50/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/90">
        <div class="mx-auto flex min-h-16 max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-3 sm:flex-nowrap sm:px-8">
          <a href="/" class="font-mono text-sm font-semibold tracking-tight text-zinc-950 transition-colors hover:text-zinc-600 dark:text-zinc-50 dark:hover:text-zinc-300" aria-label="返回首页"><span class="text-cyan-700 dark:text-cyan-400">~</span>/growth-log</a>
          <button id="theme-toggle" type="button" class="order-2 inline-flex size-9 items-center justify-center rounded-md border border-zinc-300 text-sm text-zinc-700 transition-colors hover:border-cyan-500/60 hover:text-cyan-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-cyan-400/50 dark:hover:text-cyan-300 sm:order-3" aria-label="切换深色模式" title="切换深色模式">
            <span class="dark:hidden" aria-hidden="true">☾</span><span class="hidden dark:inline" aria-hidden="true">☀</span>
          </button>
          <nav aria-label="主要导航" class="order-3 flex w-full items-center justify-between gap-1 overflow-x-auto sm:order-2 sm:ml-auto sm:w-auto sm:justify-start">
            {navigation.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class:list={[
                "whitespace-nowrap rounded-md px-2.5 py-1.5 text-sm transition-colors",
                isActive(item.href)
                  ? "bg-cyan-500/10 font-medium text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300"
                  : "text-zinc-600 hover:bg-zinc-200/70 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100",
              ]}>{item.label}</a>
            ))}
            <a href="https://account.liuguangzhong.top/" rel="noreferrer" class="whitespace-nowrap rounded-md px-2.5 py-1.5 text-sm text-cyan-700 transition-colors hover:bg-cyan-500/10 hover:text-cyan-900 dark:text-cyan-300 dark:hover:bg-cyan-400/10 dark:hover:text-cyan-100" aria-label="打开私有工作台，需登录">🔐 私有工作台 ↗</a>
          </nav>
        </div>
      </header>
      <main id="main-content" class="mx-auto w-full max-w-5xl flex-1 px-5 py-14 sm:px-8 sm:py-20"><slot /></main>
      <footer class="border-t border-zinc-200 dark:border-zinc-800">
        <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <p><span class="font-mono text-cyan-700 dark:text-cyan-400" aria-hidden="true">➜</span> © {currentYear} 技术成长档案</p>
          <p class="font-mono text-xs">built with astro + tailwind · deployed on cloudflare · <a href="/rss.xml" class="underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-cyan-700 dark:decoration-zinc-700 dark:hover:text-cyan-300">rss</a></p>
        </div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const button = document.querySelector("#theme-toggle");
        if (!(button instanceof HTMLButtonElement)) return;
        const root = document.documentElement;
        const update = () => {
          const label = root.classList.contains("dark") ? "切换到浅色模式" : "切换到深色模式";
          button.setAttribute("aria-label", label);
          button.setAttribute("title", label);
        };
        update();
        button.addEventListener("click", () => {
          const dark = !root.classList.contains("dark");
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#18181b" : "#fafafa");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
          update();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        // 彩蛋 1：打开开发者控制台，打印青色渐变 ASCII 字符画
        const shades = ["#164e63", "#0e7490", "#0891b2", "#06b6d4", "#22d3ee", "#67e8f9"];
        const art = [
          "██  ██ ███   ██  ██   ~/growth-log",
          "██  ██ ████  ██  ██   C · Python · Embedded · AI",
          "██████ ██ ███ ██ ██   blog.liuguangzhong.top",
          "██  ██ ██  ████  ██   记录成长 · 保持诚实",
          "██  ██ ██   ██   ██   ➜ 试试在页面输入 ls 后回车",
        ];
        console.log("%c growth-log %c 技术成长档案 ", "background:#0891b2;color:#fff;font-weight:bold;padding:2px 6px;border-radius:3px 0 0 3px", "background:#164e63;color:#a5f3fc;font-weight:bold;padding:2px 6px;border-radius:0 3px 3px 0");
        art.forEach((line, i) => console.log("%c" + line, `color:${shades[i % shades.length]};font-family:monospace;font-weight:bold;line-height:1.4`));

        // 彩蛋 2：页面空白处输入 ls 回车 → 终端卡片霓虹脉冲 + 目录 toast；clear 回车 → 复原
        let buf = "";
        let timer;
        const toast = (text) => {
          let el = document.querySelector("#cli-toast");
          if (!el) {
            el = document.createElement("div");
            el.id = "cli-toast";
            el.setAttribute("role", "status");
            el.className = "fixed bottom-6 left-1/2 z-50 rounded-lg border border-cyan-500/60 bg-zinc-950/95 px-4 py-2.5 font-mono text-xs text-cyan-300 shadow-lg shadow-cyan-500/10 dark:border-cyan-400/50";
            el.style.cssText = "opacity:0;transform:translate(-50%,8px);transition:opacity .2s ease,transform .2s ease;pointer-events:none";
            document.body.appendChild(el);
          }
          el.textContent = text;
          el.style.opacity = "1";
          el.style.transform = "translate(-50%,0)";
          clearTimeout(timer);
          timer = setTimeout(() => { el.style.opacity = "0"; el.style.transform = "translate(-50%,8px)"; }, 2600);
        };
        const appendLsOutput = () => {
          document.documentElement.classList.add("ls-flash");
          setTimeout(() => document.documentElement.classList.remove("ls-flash"), 1800);
          toast("➜ about/  blog/  projects/  rss.xml");
          const output = document.createElement("p");
          output.className = "ls-output";
          output.setAttribute("role", "status");
          output.setAttribute("aria-live", "polite");
          output.textContent = "$ ls  about  blog  projects  rss.xml  robots.txt";
          document.body.appendChild(output);
        };
        addEventListener("keydown", (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && (t.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(t.tagName))) return;
          if (e.key === "l") {
            buf = "l";
            return;
          }
          if (e.key === "s" && buf === "l") {
            appendLsOutput();
            buf = "";
            return;
          }
          if (e.key === "Enter") {
            if (buf === "ls") {
              appendLsOutput();
            } else if (buf === "clear") {
              document.documentElement.classList.remove("ls-flash");
              toast("➜ cleared");
            }
            buf = "";
            return;
          }
          if (e.key.length === 1) buf = (buf + e.key).slice(-5);
        });
      })();
    </script>
  </body>
</html>
